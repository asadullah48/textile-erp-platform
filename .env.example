# ─── Local PostgreSQL (Docker Compose dev) ───────────────────────────────────
POSTGRES_USER=textile_user
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=textile_erp
# Least-privilege role the API connects as (created automatically by docker compose)
APP_DB_PASSWORD=change_me_app_password

# ─── Backend ─────────────────────────────────────────────────────────────────
# Local dev:
DATABASE_URL=postgresql+asyncpg://textile_user:change_me_in_prod@localhost:5432/textile_erp

# Neon.tech (production — get from neon.tech dashboard):
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?ssl=require

# Optional: separate admin URL for auth-only flows (falls back to DATABASE_URL if unset).
# BYPASSRLS is NOT required — registration/login set the narrowest RLS context they need.
# DATABASE_ADMIN_URL=postgresql+asyncpg://admin:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?ssl=require

SECRET_KEY=change_me_in_prod_min_32_chars_long
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ALLOWED_ORIGINS accepts a JSON array for multiple origins:
# ALLOWED_ORIGINS=["https://your-app.vercel.app","http://localhost:3000"]
ALLOWED_ORIGINS=["http://localhost:3000"]

# One-click demo workspaces (POST /auth/demo): isolated, seeded, purged after 24h
DEMO_ENABLED=true
DEMO_MAX_LIVE=200

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
# Set to "browser" to serve the whole API from the browser (public demo, no backend)
# NEXT_PUBLIC_DEMO_MODE=browser
